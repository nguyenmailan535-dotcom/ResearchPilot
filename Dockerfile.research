FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DEFAULT_TIMEOUT=1000

WORKDIR /app

RUN apt-get -o Acquire::Retries=5 update && \
    apt-get -o Acquire::Retries=5 install -y --no-install-recommends \
    libgl1 libmagic1 poppler-utils tesseract-ocr && \
    rm -rf /var/lib/apt/lists/*

# Keep the large CPU PyTorch layer independent of project metadata changes.
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu \
        "torch==2.9.1+cpu" "torchvision==0.24.1+cpu"

ENV PIP_RETRIES=10

COPY pyproject.toml README.md LICENSE ./
RUN mkdir -p nanobot bridge && touch nanobot/__init__.py
RUN pip install --no-cache-dir ".[api,research]" && \
    rm -rf nanobot bridge

COPY nanobot/ nanobot/
COPY bridge/ bridge/

RUN pip install --no-cache-dir --no-deps --force-reinstall . && \
    mkdir -p /data/workspace /root/.nanobot

VOLUME ["/data/workspace", "/root/.nanobot"]
EXPOSE 18791

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:18791/health', timeout=3)"

ENTRYPOINT ["nanobot"]
CMD ["serve", "--host", "0.0.0.0", "--port", "18791", "--workspace", "/data/workspace"]
