# Port exposed by docker-compose.research.yml
RESEARCHFLOW_PORT=18791

# Persistent corpus, SQLite database, reports, and task events
RESEARCHFLOW_WORKSPACE=./workspace

# Keep BGE-M3 and reranker weights outside Docker's virtual disk.
RESEARCHFLOW_MODEL_CACHE=./.cache/huggingface

# Directory containing config.json with the configured model provider
NANOBOT_CONFIG_DIR=~/.nanobot

# Production retrieval uses Milvus BM25 sparse search and BGE-M3 dense HNSW search.  Set
# RESEARCH_RETRIEVAL_BACKEND=local to run the lightweight SQLite/NumPy test backend.
RESEARCH_RETRIEVAL_BACKEND=milvus
RESEARCH_MILVUS_URI=http://milvus-standalone:19530
RESEARCH_MILVUS_COLLECTION=researchflow_chunks
RESEARCH_MILVUS_TOKEN=
RESEARCH_EMBEDDING_MODEL=BAAI/bge-m3
RESEARCH_BGE_DEVICE=cpu
RESEARCH_BGE_USE_FP16=0
RESEARCH_UNSTRUCTURED_STRATEGY=fast
# Optional global override. The current dev-set defaults are hybrid=0.75, vector=0.55, BM25=0.18.
# RESEARCH_NO_ANSWER_THRESHOLD=0.75
RESEARCH_ENABLE_RERANKER=0
RESEARCH_RERANKER_MODEL=BAAI/bge-reranker-base

# Optional Tavily evidence fallback. Configure tools.web.search.provider=tavily in config.json and
# set this key. External evidence stays separate from RF-* local-paper citations.
TAVILY_API_KEY=

# Optional RAGAS offline evaluation (not used in the online request path).
RAGAS_MODEL=deepseek-v4-pro
RAGAS_API_KEY=
RAGAS_BASE_URL=
