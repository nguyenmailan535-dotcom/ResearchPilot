# Port exposed by docker-compose.research.yml
RESEARCHFLOW_PORT=18791

# Persistent corpus, SQLite database, reports, and task events
RESEARCHFLOW_WORKSPACE=./workspace

# Directory containing config.json with the configured model provider
NANOBOT_CONFIG_DIR=~/.nanobot

# Research retrieval. `research_search` defaults to auto (hybrid, then reflection when confidence
# is low); dense failures fall back to BM25.
RESEARCH_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Optional global override. The current dev-set defaults are hybrid=0.75, vector=0.55, BM25=0.18.
# RESEARCH_NO_ANSWER_THRESHOLD=0.75
RESEARCH_ENABLE_RERANKER=0
RESEARCH_RERANKER_MODEL=BAAI/bge-reranker-base
