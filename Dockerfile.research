FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY pyproject.toml README.md LICENSE ./
RUN mkdir -p nanobot bridge && touch nanobot/__init__.py && \
    pip install --no-cache-dir ".[api,research]" && \
    rm -rf nanobot bridge

COPY nanobot/ nanobot/
COPY bridge/ bridge/

RUN pip install --no-cache-dir --no-deps --force-reinstall . && \
    mkdir -p /data/workspace /root/.nanobot

VOLUME ["/data/workspace", "/root/.nanobot"]
EXPOSE 18791

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:18791/health', timeout=3)"

ENTRYPOINT ["nanobot"]
CMD ["serve", "--host", "0.0.0.0", "--port", "18791", "--workspace", "/data/workspace"]
